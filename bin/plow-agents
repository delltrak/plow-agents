#!/usr/bin/env python3
"""Manage the Plow agents on your account. Standard library only.

    plow-agents login            one-time: text a code, get an account token
    plow-agents lines            the global pool of lines and their availability
    plow-agents mint <line-uid>  that line's credential -> ./plow-credentials
    plow-agents profile          set or show this account's public profile (--photo takes a file)
    plow-agents rotate           replace this self-hosted agent's credential
    plow-agents revoke [line]    retire the credential-file agent, or any agent by line

`login` stores an ACCOUNT token in ~/.config/plow/token; it can list lines, mint,
rotate, revoke, and read or set the public profile, so it does travel -- over HTTPS, to Plow. What it never does is enter a
container. `mint` uses it for an AGENT credential scoped to one line, and that
second one is the only credential a container ever sees.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import stat
import subprocess
import sys
import tempfile
import time
import tomllib
import urllib.error
import urllib.parse
import urllib.request
from typing import NoReturn

DEFAULT_API_BASE = "https://api.plow.co"
CREDENTIAL_FILE = "plow-credentials"
POLL_S = 3
CONFIG_FILE = "plow-agents.toml"
DIGEST = r"sha256:[0-9a-f]{64}"
# Plow caps a profile photo at 5 MB and takes these four formats. Restated
# here only to refuse a file before any request is sent; the server decides.
MAX_PHOTO_BYTES = 5 * 1024 * 1024
PHOTO_SIGNATURES = (b"\x89PNG\r\n\x1a\n", b"\xff\xd8\xff", b"GIF87a", b"GIF89a")
TIMEOUT_S = 900


def log(message: str = "") -> None:
    print(message, file=sys.stderr, flush=True)


def die(message: str) -> NoReturn:
    raise SystemExit(f"plow-agents: {message}")


def request(
    method: str,
    url: str,
    *,
    body: dict | None = None,
    token: str | None = None,
    data: bytes | None = None,
    content_type: str | None = None,
) -> tuple[int, object]:
    """One call, JSON in by default. Returns (status, parsed body); never raises on HTTP status.

    `data`/`content_type` are for the one request that is not JSON in: the
    profile photo upload, which sends the file itself.
    """
    headers = {"Accept": "application/json"}
    if data is None and body is not None:
        data, content_type = json.dumps(body).encode(), "application/json"
    if content_type is not None:
        headers["Content-Type"] = content_type
    if token is not None:
        headers["Authorization"] = f"Bearer {token}"
    req = urllib.request.Request(url, data=data, headers=headers, method=method)
    # HTTP is restricted to development hosts; their credentials must bypass proxies.
    open_url = urllib.request.build_opener(urllib.request.ProxyHandler({})).open if req.type == "http" else urllib.request.urlopen
    try:
        with open_url(req, timeout=30) as response:
            raw, status = response.read(), response.status
    except urllib.error.HTTPError as error:
        raw, status = error.read(), error.code
    except OSError as error:
        die(f"cannot reach {url}: {error}")
    try:
        return status, json.loads(raw)
    except ValueError:
        return status, None


def call(method: str, base: str, path: str, **kwargs) -> object:
    """The same call, with a non-2xx as a fatal error rather than a value."""
    status, payload = request(method, base + path, **kwargs)
    if status // 100 != 2:
        detail = payload.get("detail") if isinstance(payload, dict) else None
        if isinstance(detail, dict):
            detail = detail.get("message")
        die(f"{method} {path} answered {status}" + (f": {detail}" if detail else ""))
    return payload


def write_private(path: str, body: str) -> str:
    """Write a mode-600 file atomically. Returns the absolute path.

    The temporary name is unpredictable and created O_EXCL|O_NOFOLLOW, the mode
    is checked rather than assumed, and the rename is last -- so a failed run
    leaves the previous credential intact.
    """
    destination = os.path.abspath(path)
    directory = os.path.dirname(destination) or "."
    os.makedirs(directory, mode=0o700, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(dir=directory, prefix=".plow-agents.", suffix=".new")
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "w") as handle:
            handle.write(body)
        if stat.S_IMODE(os.stat(temporary).st_mode) != 0o600:
            die("refusing to install a credential that is not mode 600")
        os.replace(temporary, destination)
    except BaseException:
        try:
            os.unlink(temporary)
        except OSError:
            pass
        raise
    return destination


def read_credential(path: str) -> dict[str, str]:
    """Read the self-hosted agent identity and its container's API address."""
    try:
        with open(path) as handle:
            credential = {}
            for line in handle:
                line = line.strip()
                if line.startswith("# plow-agent-uid:"):
                    key, value = "agent_uid", line.partition(":")[2].strip()
                elif line.startswith("#") or "=" not in line:
                    continue
                else:
                    key, value = line.split("=", 1)
                    if key not in ("PLOW_API_BASE", "PLOW_AGENT_TOKEN"):
                        continue
                if key == "agent_uid" and key in credential and credential[key] != value:
                    die("conflicting agent UIDs in credential -- resolve before continuing")
                credential[key] = value
            return credential
    except FileNotFoundError:
        return {}


def credential_agent_uid(credential: dict[str, str]) -> str:
    uid = credential.get("agent_uid", "")
    if not uid:
        die("no valid # plow-agent-uid: comment in plow-credentials -- use `revoke <line>` to retire the agent")
    return uid


def install_credential(path: str, uid: str, token: str, base: str) -> None:
    if any(character in token + base + uid for character in "\r\n\"\\"):
        die("the credential carries quote or newline characters")
    written = write_private(path, f"PLOW_API_BASE={base}\nPLOW_AGENT_TOKEN={token}\n# plow-agent-uid: {uid}\n")
    log(f"Wrote {written} (mode 600).")


def strip_v1(base: str) -> str:
    """Validate an API root before requests, then remove an optional `/v1`."""
    if not base or any(character in base for character in "\r\n\"\\"):
        die("API base must be nonempty and contain no quotes, backslashes, or newlines")
    base = base.rstrip("/")
    base = base[: -len("/v1")] if base.endswith("/v1") else base
    if not base:
        die("API base must not be empty after normalization")
    return base


def token_path(override: str | None) -> str:
    if override:
        return os.path.abspath(override)
    config = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
    return os.path.join(config, "plow", "token")


def account_token(args: argparse.Namespace) -> str:
    path = token_path(args.token_file)
    try:
        with open(path) as handle:
            token = handle.read().strip()
    except OSError:
        die(f"no account token at {path} -- run `plow-agents login` first")
    if not token:
        die(f"{path} is empty -- run `plow-agents login` again")
    return token


# --- verbs -----------------------------------------------------------------


def pool_lines(base: str, token: str) -> list[dict]:
    """Read pool lines and their assistant occupancy from Plow."""
    return call("GET", base, "/v1/lines", token=token)["data"]


def is_phone_line(line: dict) -> bool:
    """Whether an agent can be deployed on this line."""
    return line["provider_type"] == "imessage"


def require_phone_line(base: str, token: str, uid: str) -> dict:
    line = next((row for row in pool_lines(base, token) if row["uid"] == uid), None)
    if line is None:
        die(f"unknown line:{uid}")
    if not is_phone_line(line):
        die(f"line:{uid} is not a phone line -- `plow-agents lines` lists the ones an agent can answer on")
    return line


def login(args: argparse.Namespace) -> None:
    payload = call("POST", args.api_base, "/v1/auth/activate", body={"name": "plow-agents"})
    code, secret, send_to = (payload.get(k, "") for k in ("display_code", "activation_secret", "send_to"))
    if not (code and secret and send_to):
        die("activation returned no code, secret or number")
    log("")
    log(f"  Text  Plow Activate: {code}  to  {send_to}")
    log("")
    log("Waiting for that text ...")
    deadline = time.monotonic() + TIMEOUT_S
    while time.monotonic() < deadline:
        status, body = request("POST", args.api_base + "/v1/auth/activate/redeem", body={"activation_secret": secret})
        if status == 410:
            die("the code expired -- it is single-use and time-limited; run login again")
        if status // 100 != 2:
            die(f"redeem answered {status} -- run login again for a fresh code")
        if isinstance(body, dict) and body.get("status") == "verified":
            token = body.get("token") or ""
            if not token:
                die("activation verified but returned no token")
            written = write_private(token_path(args.token_file), token + "\n")
            log(f"Wrote {written} (mode 600). This is your ACCOUNT token -- it stays here.")
            return
        time.sleep(POLL_S)
    die(f"timed out after {TIMEOUT_S}s waiting for the text")


def lines(args: argparse.Namespace) -> None:
    token = account_token(args)
    available = [row for row in pool_lines(args.api_base, token) if is_phone_line(row)]
    print("LINE\tNAME\tNUMBER\tSTATUS")
    for line in sorted(available, key=lambda line: line["uid"]):
        status = line["agent_uid"] or ({True: "free", False: "in use"}.get(line.get("available"), "unknown"))
        print(f"{line['uid']}\t{line.get('display_name') or ''}\t{line.get('provider_key') or ''}\t{status}")


def is_hosted_url(value: str) -> bool:
    """Whether a `--photo` value names something already hosted, or a file here.

    The scheme decides, and schemes are case-insensitive: a prefix test that
    was not read `HTTPS://example.com/ada.jpg` as a filename, and went looking
    for it on disk. Anything urlsplit cannot parse is treated as a path, which
    is where an unparseable value gets the error that names it -- `cannot
    read`, with the value in it -- instead of a traceback.
    """
    try:
        return urllib.parse.urlsplit(value).scheme.lower() in ("http", "https")
    except ValueError:
        return False


def read_photo(path: str) -> bytes:
    """The file's bytes, refused here rather than over the network if unusable.

    Everything knowable without asking Plow is settled before the first
    request goes out, because `profile` may be writing a name too: a file that
    turns out to be unopenable, oversized, or not an image AFTER the name has
    landed is a command that half happened. Plow checks all of it again -- it
    has to, this is not its only client -- and stays the authority; this is
    only about not starting what cannot finish.
    """
    try:
        with open(path, "rb") as handle:
            content = handle.read(MAX_PHOTO_BYTES + 1)
    except OSError as error:
        die(f"cannot read {path}: {error}")
    if len(content) > MAX_PHOTO_BYTES:
        die(f"{path} is larger than {MAX_PHOTO_BYTES // (1024 * 1024)} MB")
    if not (content.startswith(PHOTO_SIGNATURES) or (content[:4] == b"RIFF" and content[8:12] == b"WEBP")):
        die(f"{path} is not a PNG, JPEG, GIF, or WebP image")
    return content


def upload_photo(api_base: str, token: str, path: str, content: bytes, name: str | None) -> object:
    """Send the image, and the display name with it. Returns the profile Plow answers with.

    One request, because that route writes both in the transaction that stores
    the bytes. Uploading and then PATCHing the name meant a failure at the
    second call left the photo stored and public beside the name it was sent
    to replace, and nothing here could say which half had happened.
    """
    # RFC 7578, standard library, the one non-JSON request this tool makes. A
    # quote, backslash or newline in the filename would rewrite the header
    # around it, so only a conservative set of characters survives into it.
    # The part's own type is left as octet-stream: Plow reads the signature of
    # the bytes rather than anything the uploader claims, so a guess here
    # would only be a guess.
    boundary = "----plow-agents-" + os.urandom(16).hex()
    filename = "".join(c if c.isalnum() or c in "._-" else "_" for c in os.path.basename(path)) or "photo"
    body = b""
    if name is not None:
        body += f'--{boundary}\r\nContent-Disposition: form-data; name="display_name"\r\n\r\n{name}\r\n'.encode()
    body += (
        f"--{boundary}\r\n"
        f'Content-Disposition: form-data; name="file"; filename="{filename}"\r\n'
        "Content-Type: application/octet-stream\r\n\r\n"
    ).encode() + content + f"\r\n--{boundary}--\r\n".encode()
    return call(
        "POST",
        api_base,
        "/v1/auth/profile/photo",
        token=token,
        data=body,
        content_type=f"multipart/form-data; boundary={boundary}",
    )


def profile(args: argparse.Namespace) -> None:
    token = account_token(args)
    if args.show:
        if args.name is not None or args.photo is not None:
            die("profile --show cannot be combined with --name or --photo")
        print(json.dumps(call("GET", args.api_base, "/v1/auth/profile", token=token), sort_keys=True))
        return
    if args.name is None and args.photo is None:
        die("profile needs --name, --photo, or --show")

    # A photo already hosted somewhere public is just a field, so it travels in
    # the same PATCH as the name. A local file is not a field: it is uploaded,
    # and that route takes the name alongside it and writes both as it stores
    # the bytes. Either way this is exactly one request, so a run either
    # happened or it did not -- there is no half of it to be left behind.
    upload = args.photo is not None and not is_hosted_url(args.photo)
    content = read_photo(args.photo) if upload else b""
    if upload:
        result = upload_photo(args.api_base, token, args.photo, content, args.name)
    else:
        body = {}
        if args.name is not None:
            body["display_name"] = args.name
        if args.photo is not None:
            body["photo_url"] = args.photo
        result = call("PATCH", args.api_base, "/v1/auth/profile", token=token, body=body)
    print(json.dumps(result, sort_keys=True))


def mint(args: argparse.Namespace) -> None:
    line_uid = args.line
    destination = os.path.abspath(args.credential_file)
    if os.path.isdir(destination):
        die(
            f"{destination} is a directory -- run `docker compose down -v && "
            f"rmdir {destination}`, then mint again"
        )
    if os.path.exists(destination):
        die(f"{destination} already exists -- use `plow-agents rotate` or `plow-agents revoke <line>` to retire the agent; remove this file manually if its ownership cannot be verified")
    account = account_token(args)
    # Two agents on one line both answer the same chat and the owner cannot
    # tell which replied, so the line is checked here, before anything is
    # created. There is no flag to proceed anyway: retire the agent that holds
    # it first, which is a decision rather than a keystroke.
    line = require_phone_line(args.api_base, account, line_uid)
    if line["agent_uid"]:
        die(f"line:{line_uid} already answers as agent {line['agent_uid']} -- retire it with `plow-agents revoke {line_uid}`")
    if line.get("available") is False:
        die(f"line:{line_uid} is in use by another account -- choose a free line")
    minted = call("POST", args.api_base, "/v1/agents", token=account,
                  body={"name": "plow-agent", "provider": "self_hosted", "line_uid": line_uid})
    agent, token = minted["agent"], minted["token"]
    if not token:
        die("the self-hosted agent create returned no token")
    if not agent["uid"]:
        die("the self-hosted agent create returned no agent uid")
    try:
        install_credential(destination, agent["uid"], token, args.agent_api_base)
    except BaseException:
        # A one-time token that never reached its file must not leave a live agent.
        log(f"Install to {destination} failed -- retiring agent {agent['uid']}.")
        call("DELETE", args.api_base, f"/v1/agents/{urllib.parse.quote(agent['uid'], safe='')}", token=account)
        raise
    log(f"Created agent {agent['uid']} for line:{line_uid}.")


def rotate(args: argparse.Namespace) -> None:
    path = os.path.abspath(args.credential_file)
    credential = read_credential(path)
    uid = credential_agent_uid(credential)
    base = strip_v1(credential.get("PLOW_API_BASE", ""))
    rotated = call("POST", args.api_base, f"/v1/agents/{urllib.parse.quote(uid, safe='')}/credential", token=account_token(args))
    if not rotated["token"]:
        die("rotation returned no self-hosted token")
    install_credential(path, uid, rotated["token"], base)
    log(f"Rotated agent {uid}. Recreate its container to load the new credential.")


def revoke(args: argparse.Namespace) -> None:
    """Retire this file's self-hosted agent, or any agent on a line."""
    path = os.path.abspath(args.credential_file)
    credential = read_credential(path)
    account = account_token(args)
    if args.line:
        available = pool_lines(args.api_base, account)
        line = next((line for line in available if line["uid"] == args.line), None)
        if line is None:
            die(f"unknown line:{args.line}")
        uid = line["agent_uid"]
        if not uid:
            die(f"line:{args.line} has no agent -- left {path} untouched")
    else:
        uid = credential_agent_uid(credential)
    agent = call("GET", args.api_base, f"/v1/agents/{urllib.parse.quote(uid, safe='')}", token=account)
    if not args.line and agent["provider"] != "self_hosted":
        die(f"{uid} is not self-hosted -- delete that agent in Plow")
    status, _ = request("DELETE", args.api_base + f"/v1/agents/{urllib.parse.quote(uid, safe='')}", token=account)
    if args.line and status // 100 == 5:
        die(f"agent {uid}: HTTP {status}; retirement may be incomplete -- re-run `plow-agents revoke {args.line}`")
    if status // 100 != 2 and status != 404:
        die(f"could not retire agent {uid}: HTTP {status}")
    log(f"Retired agent {uid} ({agent['provider']}) on line:{args.line}." if args.line else f"Retired agent {uid}.")
    if args.line and status // 100 == 2:
        log(f"If this agent had authenticated, your chats on line:{args.line} were retired too.")
    if credential.get("agent_uid") != uid:
        if os.path.exists(path):
            log(f"Left {path} in place: it does not name agent {uid}. Remove it manually only after confirming its ownership.")
        return
    if not os.path.exists(path):
        return
    try:
        os.unlink(path)
    except OSError as error:
        log(f"{path} could not be removed ({error}). It names a retired agent; delete it yourself.")
        raise SystemExit(2)
    log(f"Removed {path}.")


def project() -> dict[str, str]:
    try:
        with open(CONFIG_FILE, "rb") as handle:
            settings = tomllib.load(handle)
    except FileNotFoundError:
        return {}
    except tomllib.TOMLDecodeError as error:
        die(f"{CONFIG_FILE}: {error}")
    if any(key != "image" or not isinstance(value, str) for key, value in settings.items()):
        die(f"{CONFIG_FILE} accepts only an image string")
    return settings


def project_image(image: str | None) -> str:
    if image is None:
        image = project().get("image", "")
    if not image:
        die(f"pass IMAGE or set image in ./{CONFIG_FILE}")
    if image.startswith("-") or "@" in image or "/" not in image or any(c.isspace() for c in image):
        die("image must be a registry/repository:tag")
    host = image.split("/", 1)[0]
    if "." not in host.split(":", 1)[0]:
        die("image needs an explicit registry host, such as docker.io or ghcr.io")
    return image


def image_repository(image: str) -> str:
    host, name = image.split("/", 1)
    return f"{host}/{name.rsplit(':', 1)[0]}"


def dockerignore_patterns(path: str) -> list[tuple[re.Pattern[str], bool]]:
    try:
        with open(path, encoding="utf-8-sig") as handle:
            lines = handle.readlines()
    except FileNotFoundError:
        return []
    patterns = []
    for line in lines:
        if line.startswith("#") or not line.strip():
            continue
        pattern = line.strip()
        exclude = not pattern.startswith("!")
        pattern = os.path.normpath(pattern if exclude else pattern[1:].strip()).strip("/")
        if pattern == ".":
            continue
        # Docker globs are rooted, match parent directories, and apply in order.
        tokens = re.findall(r"\\.|\*\*/?|\[(?:\\.|[^\\\]])*\]|.", pattern)
        expression = ""
        for index, token in enumerate(tokens):
            if token.startswith("**"):
                expression += ".*" if index == len(tokens) - 1 else "(?:.*/)?"
            elif token == "*":
                expression += "[^/]*"
            elif token == "?":
                expression += "[^/]"
            elif token.startswith("["):
                expression += "(?!/)" + token
            else:
                expression += re.escape(token[1:] if token.startswith("\\") else token)
        patterns.append((re.compile(expression + r"(?:/.*)?\Z", re.DOTALL), exclude))
    return patterns


def refuse_credentials(args: argparse.Namespace, ignore_file: str) -> None:
    account_file = os.path.realpath(token_path(args.token_file))
    patterns = dockerignore_patterns(ignore_file)
    def failed(error: OSError) -> NoReturn:
        die(f"cannot check build context for credentials: {error}")
    for directory, _, files in os.walk(".", onerror=failed):
        for filename in files:
            path = os.path.join(directory, filename)
            relative = os.path.relpath(path)
            excluded = False
            for pattern, exclude in patterns:
                if pattern.match(relative):
                    excluded = exclude
            # Docker always reads the build Dockerfile, even when ignored.
            if excluded and relative != "Dockerfile":
                continue
            if os.path.realpath(path) == account_file:
                die(f"add {relative} to {ignore_file} before building")
            try:
                with open(path, "rb") as handle:
                    if any(b"PLOW_AGENT_TOKEN=" in line or line.lstrip().startswith(b"# plow-agent-uid:") for line in handle):
                        if relative == "Dockerfile":
                            die("remove credentials from Dockerfile before building")
                        die(f"add {relative} to {ignore_file} before building")
            except OSError as error:
                failed(error)


def docker(*arguments: str) -> str:
    command = ["docker", *arguments]
    log("$ " + " ".join(command))
    try:
        result = subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False)
    except OSError as error:
        die(f"cannot run docker: {error}")
    log(result.stdout.rstrip())
    if result.stderr:
        log(result.stderr.rstrip())
    if result.returncode:
        die(f"docker {' '.join(arguments)} failed ({result.returncode})")
    return result.stdout


def image_build(args: argparse.Namespace) -> None:
    image = project_image(args.image)
    refuse_credentials(args, "Dockerfile.dockerignore" if os.path.exists("Dockerfile.dockerignore") else ".dockerignore")
    docker("build", "--platform", "linux/amd64", "--tag", image, ".")


def image_push(args: argparse.Namespace) -> None:
    image = project_image(args.image)
    found = re.findall(r"digest: (" + DIGEST + r")\b", docker("push", image))
    if not found:
        die("docker push printed no sha256 digest")
    print(f"{image_repository(image)}@{found[-1]}")


def deploy(args: argparse.Namespace) -> None:
    if args.local:
        if args.target:
            die("--local takes no target; it starts this checkout's Compose project")
        ignore_file = "Dockerfile.dockerignore" if os.path.exists("Dockerfile.dockerignore") else ".dockerignore"
        excluded = False
        for pattern, exclude in dockerignore_patterns(ignore_file):
            if pattern.match(CREDENTIAL_FILE):
                excluded = exclude
        if not excluded:
            die(f"add {CREDENTIAL_FILE} to {ignore_file} before building")
    else:
        if args.agent_api_base is not None:
            die("deploy --agent-api-base requires --local")
        target = args.target or ""
        if target.startswith("exe:"):
            if not re.fullmatch(r"exe:[a-z0-9][a-z0-9_-]*", target):
                die("expected exe:<slug>")
            provider, name = target, target[4:]
        else:
            repository, separator, digest = target.partition("@")
            if not separator or not re.fullmatch(DIGEST, digest):
                die("deploy needs image@sha256:<64 hex>, exe:<slug>, or --local")
            repository = project_image(repository)
            provider = f"exe:{repository}@{digest}"
            name = image_repository(repository).rsplit("/", 1)[-1]
    token = account_token(args)
    if args.local:
        args.credential_file = CREDENTIAL_FILE
        mint(args)
        try:
            docker("compose", "up", "--build", "-d")
        except (SystemExit, KeyboardInterrupt):
            log("Compose up did not complete. Agent and plow-credentials kept. "
                "Fix Compose and run `docker compose up --build -d`, "
                "or run `plow-agents revoke` to retire the agent.")
            raise
        log("Requested local agent. Run `docker compose logs -f` to watch startup.")
    else:
        require_phone_line(args.api_base, token, args.line)
        created = call("POST", args.api_base, "/v1/agents", token=token,
                       body={"name": name, "line_uid": args.line, "provider": provider})
        log(f"Requested agent {created['agent']['uid']} on line:{args.line}. Run `plow-agents agents` for status.")


def agents(args: argparse.Namespace) -> None:
    deployed = call("GET", args.api_base, "/v1/agents", token=account_token(args))
    print("LINE\tTARGET\tSTATUS")
    for agent in deployed:
        status = agent.get("status") or "-"
        if agent.get("failure_code"):
            status += f"({agent['failure_code']})"
        target = agent["provider"].removeprefix("exe:")
        print(f"{(agent.get('line') or {}).get('uid') or '-'}\t{target}\t{status}")


def main() -> int:
    parser = argparse.ArgumentParser(prog="plow-agents", description=__doc__.splitlines()[0])
    parser.add_argument("--api-base", default=DEFAULT_API_BASE, help=f"Plow API root, without /v1 (default {DEFAULT_API_BASE})")
    parser.add_argument("--token-file", default=None, help="account token (default ~/.config/plow/token)")
    verbs = parser.add_subparsers(dest="verb", required=True)

    it = verbs.add_parser("login", help="text a code, store this account's token")
    it.set_defaults(run=login)

    verbs.add_parser("lines", help="phone lines an agent can be deployed on, with availability").set_defaults(run=lines)

    it = verbs.add_parser("profile", help="set or show this account's public profile")
    it.add_argument("--name", help="public display name")
    it.add_argument("--photo", help="a local image file, or a public https URL")
    it.add_argument("--show", action="store_true", help="show the current profile")
    it.set_defaults(run=profile)

    it = verbs.add_parser("mint", help="a credential for one line, written to ./plow-credentials")
    it.add_argument("line", help="line uid, as printed by `lines`")
    it.add_argument("--credential-file", default=CREDENTIAL_FILE, help=f"where to write the credential (default ./{CREDENTIAL_FILE})")
    it.add_argument("--agent-api-base", default=None, help="the API root written into the credential, if the container reaches Plow at a different address than this machine does (default: --api-base)")
    it.set_defaults(run=mint)

    it = verbs.add_parser("rotate", help="replace this agent's credential in ./plow-credentials")
    it.add_argument("--credential-file", default=CREDENTIAL_FILE, help=f"the credential to rotate (default ./{CREDENTIAL_FILE})")
    it.set_defaults(run=rotate)

    it = verbs.add_parser("revoke", help="retire the credential-file agent, or any agent on a line")
    it.add_argument("line", nargs="?", help="line uid whose agent should be retired (cloud or self-hosted)")
    it.add_argument("--credential-file", default=CREDENTIAL_FILE, help=f"the credential to revoke (default ./{CREDENTIAL_FILE})")
    it.set_defaults(run=revoke)

    it = verbs.add_parser("image", help="build or push this project's image")
    images = it.add_subparsers(dest="image_verb", required=True)
    for verb, run in (("build", image_build), ("push", image_push)):
        image = images.add_parser(verb, help=f"{verb} an image")
        image.add_argument("image", nargs="?", metavar="IMAGE", help="registry/repository:tag")
        image.set_defaults(run=run)

    it = verbs.add_parser("deploy", help="request an agent on a line")
    it.add_argument("target", nargs="?", help="image@sha256:... or exe:<slug>")
    it.add_argument("--line", required=True, help="line uid, as printed by `lines`")
    it.add_argument("--local", action="store_true", help="mint a credential and start this Compose project")
    it.add_argument("--agent-api-base", default=None, help="with --local, the API root the container reaches (default: --api-base)")
    it.set_defaults(run=deploy)
    verbs.add_parser("agents", help="list agent targets and status").set_defaults(run=agents)

    args = parser.parse_args()
    # The agent builds `${PLOW_API_BASE}/v1`, so a /v1 here would 404 every call.
    args.api_base = strip_v1(args.api_base)
    endpoint = urllib.parse.urlsplit(args.api_base)
    host = endpoint.hostname or ""
    local = host in ("localhost", "127.0.0.1", "::1") or host.endswith(".orb.local")
    if not host or not (endpoint.scheme == "https" or endpoint.scheme == "http" and local):
        die("--api-base requires HTTPS except for localhost, 127.0.0.1, ::1, or *.orb.local")
    # `--api-base` is where *this tool* calls; the credential says where the
    # *container* calls. The same address usually, but not against a local
    # stack: a 127.0.0.1 that works out here is the container's own loopback.
    if args.verb == "mint" or (args.verb == "deploy" and args.local):
        args.agent_api_base = strip_v1(args.agent_api_base) if args.agent_api_base is not None else args.api_base
    args.run(args)
    return 0


if __name__ == "__main__":
    sys.exit(main())
